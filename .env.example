# Copy to .env and fill in. NEVER commit .env
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_TOKEN=

# Model names change often. Verify in each provider's docs before running.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat

USER_AGENT=GraphOneTrialBot/0.1 (+your-email@example.com)
MAX_CONCURRENCY=20
PER_DOMAIN_CONCURRENCY=3
LLM_MAX_INPUT_CHARS=12000
